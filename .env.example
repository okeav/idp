# ── Core ──────────────────────────────────────────────────────────────────
IDP_ISSUER=https://idp.example.com
NODE_ENV=development

# ── MongoDB (required) ───────────────────────────────────────────────────
IDP_MONGO_URI=mongodb://localhost:27017/idp

# ── Cache (optional — defaults to in-memory, single-instance only) ──────
# Set to "redis" for production / multi-instance deployments.
IDP_CACHE_ADAPTER=memory
IDP_REDIS_HOST=localhost
IDP_REDIS_PORT=6379
IDP_REDIS_PASSWORD=
IDP_CACHE_KEY_PREFIX=idp:

# ── Signing keys (RS256). Accepts raw PEM or base64-encoded PEM ─────────
IDP_SIGNING_KEY_CURRENT_KID=change-me-uuid
IDP_SIGNING_KEY_CURRENT_PRIVATE_B64=
IDP_SIGNING_KEY_CURRENT_PUBLIC_B64=
IDP_SIGNING_KEY_PREVIOUS_KID=
IDP_SIGNING_KEY_PREVIOUS_PRIVATE_B64=
IDP_SIGNING_KEY_PREVIOUS_PUBLIC_B64=

# ── Cookies ───────────────────────────────────────────────────────────────
IDP_COOKIE_SECURE=true
IDP_COOKIE_SAME_SITE=lax
IDP_COOKIE_DOMAIN=

# ── Security policy ───────────────────────────────────────────────────────
IDP_MAX_FAILED_LOGIN_ATTEMPTS=5
IDP_ACCOUNT_LOCK_DURATION_MS=1800000
IDP_BCRYPT_ROUNDS=12
# Blind-index pepper for email lookups. Non-rotating, back it up carefully —
# rotating it invalidates every existing user's email lookup hash.
IDP_EMAIL_HASH_PEPPER=
# HMAC key for hashing opaque refresh/reset/verification tokens at rest.
IDP_TOKEN_HASH_SECRET=

# ── MFA ────────────────────────────────────────────────────────────────────
IDP_MFA_ISSUER_LABEL=MyApp
IDP_MFA_RECOVERY_CODE_COUNT=10

# ── OAuth providers (omit any you don't use) ─────────────────────────────
IDP_SSO_GOOGLE_CLIENT_ID=
IDP_SSO_GOOGLE_CLIENT_SECRET=
IDP_SSO_MICROSOFT_CLIENT_ID=
IDP_SSO_MICROSOFT_CLIENT_SECRET=
IDP_SSO_MICROSOFT_TENANT=common
IDP_SSO_GITHUB_CLIENT_ID=
IDP_SSO_GITHUB_CLIENT_SECRET=
IDP_SSO_APPLE_CLIENT_ID=
IDP_SSO_APPLE_TEAM_ID=
IDP_SSO_APPLE_KEY_ID=
IDP_SSO_APPLE_PRIVATE_KEY_B64=
IDP_SSO_LINKEDIN_CLIENT_ID=
IDP_SSO_LINKEDIN_CLIENT_SECRET=

# ── Service mesh (optional — S2S / JWKS trust feature) ───────────────────
IDP_S2S_BOOTSTRAP_SECRET=
IDP_S2S_TOKEN_MODE=both

# ── Rate limiting (enabled by default) ───────────────────────────────────
# Per-rule thresholds (login/passwordReset/mfaChallenge/refreshToken/magicLink)
# have sensible defaults — see README "Rate limiting" — and are only
# overridable via code config, not env vars. Set to "redis" to reuse the
# cache adapter's Redis connection (if IDP_CACHE_ADAPTER=redis) automatically.
IDP_RATE_LIMIT_ENABLED=true
IDP_RATE_LIMIT_ADAPTER=memory

# ── Magic link (passwordless email login) ────────────────────────────────
# Set to false for invite-only apps — an unrecognized email then silently
# no-ops instead of signing someone up via magic link.
IDP_MAGIC_LINK_ALLOW_SIGNUP=true

# ── WebAuthn / passkeys (optional — omit to leave passkey routes disabled) ─
# rpID must be the *frontend's* registrable domain, not necessarily this
# API's own host.
IDP_WEBAUTHN_RP_ID=
IDP_WEBAUTHN_RP_NAME=MyApp
IDP_WEBAUTHN_ORIGIN=

# ── Outbound webhooks (optional — additive to the in-process hooks) ─────
# Single-endpoint convenience; configure config.webhooks.endpoints directly
# in code for multiple endpoints.
IDP_WEBHOOK_URL=
IDP_WEBHOOK_SECRET=
