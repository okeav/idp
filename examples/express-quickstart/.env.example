# Copy to .env — every value here has a working default in server.js if omitted,
# except IDP_SIGNING_KEY_* (omit them entirely and the quickstart generates a
# throwaway keypair for you, invalidated on every restart).

# The DEV-ONLY fallbacks below (secrets, signing key) are used only with NODE_ENV=development, set
# explicitly. Remove this line anywhere real — every value must then be set, or the server won't start.
NODE_ENV=development

PORT=3000
IDP_ISSUER=http://localhost:3000

# Matches docker-compose.yml in the repo root as-is.
IDP_MONGO_URI=mongodb://localhost:27017/idp-quickstart?replicaSet=rs0
IDP_CACHE_ADAPTER=memory

# Leave unset to get an ephemeral dev keypair (simplest). To persist sessions
# across restarts, generate one and paste the base64 PEM here instead:
#   node -e "const{generateKeyPairSync}=require('crypto');const{privateKey,publicKey}=generateKeyPairSync('rsa',{modulusLength:2048,publicKeyEncoding:{type:'spki',format:'pem'},privateKeyEncoding:{type:'pkcs8',format:'pem'}});console.log('IDP_SIGNING_KEY_PRIVATE='+Buffer.from(privateKey).toString('base64'));console.log('IDP_SIGNING_KEY_PUBLIC='+Buffer.from(publicKey).toString('base64'));"
IDP_SIGNING_KEY_PRIVATE=
IDP_SIGNING_KEY_PUBLIC=

# Leave blank in development to use the quickstart's DEV-ONLY fallbacks. Without NODE_ENV=development these
# (and IDP_MFA_ENCRYPTION_KEY, IDP_SIGNING_KEY_*) must be real secrets — the server refuses to start otherwise.
# Generate each with: openssl rand -base64 48
IDP_EMAIL_HASH_PEPPER=
IDP_TOKEN_HASH_SECRET=
IDP_MFA_ENCRYPTION_KEY=
