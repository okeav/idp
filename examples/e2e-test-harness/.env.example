# Copy to .env to customize. Everything here has a working default except
# the Google credentials (flow 10 — SSO), which only you can supply.

PORT=3100
IDP_MONGO_URI=mongodb://localhost:27017/idp-e2e-harness?replicaSet=rs0

# Flow 10 (SSO) — optional. Without these, the SSO page clearly shows as
# "not configured" with exact setup instructions; every other flow works
# without them. See README.md's checklist, item 10.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
