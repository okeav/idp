{
  "name": "@okeav/idp-core",
  "version": "0.2.0",
  "description": "Standalone, pluggable identity provider for Node.js/TypeScript backends — OAuth2/OIDC authorization server, password + MFA + social login, session management, and service-to-service JWKS trust. Bring your own MongoDB.",
  "type": "module",
  "license": "MIT",
  "author": "Okeav",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/okeav/idp.git"
  },
  "bugs": {
    "url": "https://github.com/okeav/idp/issues"
  },
  "homepage": "https://github.com/okeav/idp#readme",
  "publishConfig": {
    "access": "public"
  },
  "main": "./src/index.js",
  "types": "./types/index.d.ts",
  "scripts": {
    "test": "node --test"
  },
  "exports": {
    ".": {
      "import": "./src/index.js",
      "types": "./types/index.d.ts"
    }
  },
  "files": [
    "src",
    "types",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    ".env.example"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@simplewebauthn/server": "^13.3.2",
    "bcrypt": "^6.0.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.7.4",
    "otplib": "^13.4.1",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "cookie-parser": "^1.4.7",
    "express": "^4.18 || ^5.0",
    "ioredis": "^5.0.0"
  },
  "peerDependenciesMeta": {
    "ioredis": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.10",
    "mongodb-memory-server": "^11.2.0"
  },
  "keywords": [
    "identity-provider",
    "oauth2",
    "oidc",
    "authentication",
    "jwt",
    "jwks",
    "mfa",
    "sso"
  ]
}
